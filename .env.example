# ─────────────────────────────────────────────────────────────────────────────
# Frontend Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Environment
NEXT_ENV=development
# Exemplo de configuração de variáveis de ambiente
# Copie este arquivo como .env.local na raiz do projeto

# =====================================================
# NextAuth Configuration
# =====================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=seu-secret-aleatorio-aqui-min-32-caracteres

# =====================================================
# Backend API
# =====================================================
NEXT_PUBLIC_API_URL=http://localhost:8000

# =====================================================
# OAuth Providers
# =====================================================
# GitHub OAuth - https://github.com/settings/developers
GITHUB_ID=seu_github_client_id
GITHUB_SECRET=seu_github_client_secret

# Google OAuth - https://console.cloud.google.com/
GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_google_client_secret

# Discord OAuth - https://discord.com/developers/applications
DISCORD_CLIENT_ID=seu_discord_client_id
DISCORD_CLIENT_SECRET=seu_discord_client_secret

# Microsoft OAuth - https://entra.microsoft.com/
MICROSOFT_CLIENT_ID=seu_microsoft_client_id
MICROSOFT_CLIENT_SECRET=seu_microsoft_client_secret
MICROSOFT_TENANT_ID=common

# =====================================================
# Node Environment
# =====================================================
NODE_ENV=development

# Opcional: Timeout para requisições (em ms)
# NEXT_PUBLIC_API_TIMEOUT=10000

# Opcional: Enable detailed logging
# NEXT_PUBLIC_DEBUG=true
